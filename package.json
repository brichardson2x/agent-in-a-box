{
  "name": "gitagent",
  "version": "0.1.0",
  "description": "AI-powered issue-to-PR agent driven by webhooks and autonomous agents.",
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "lint": "eslint . --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --check ."
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@octokit/auth-app": "^7.2.2",
    "better-sqlite3": "^8.5.0",
    "dotenv": "^16.4.7",
    "express": "^4.19.2",
    "node-fetch": "^3.3.2",
    "pino": "^8.14.0",
    "pino-http": "^11.0.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^4.17.21",
    "@types/node": "^20.6.0",
    "@types/node-fetch": "^3.0.3",
    "@types/pino-http": "^6.1.0",
    "@types/uuid": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.56.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.0.0",
    "prettier": "^3.2.2",
    "ts-node": "^10.9.1",
    "tsx": "^4.21.0",
    "typescript": "^5.5.0",
    "vitest": "^1.6.0"
  }
}
