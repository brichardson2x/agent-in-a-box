PLATFORM=github
AGENT=codex
BOT_HANDLE=gitagent
PLATFORM_TOKEN=ghp_your_token_here
REVIEWER_USERNAME=reviewer
WEBHOOK_SECRET=change-me
REPO_PATH=/path/to/repo
REPO_REMOTE=git@github.com:owner/repo.git
AGENT_SYSTEM_PROMPT=You are GitAgent, a helpful automation assistant.

# Optional overrides
OPENAI_API_KEY=sk-your-openai-key
COPILOT_TOKEN=gho-your-copilot-token
SQLITE_PATH=./data/agent.db
PORT=3000
LOG_LEVEL=info
DEFAULT_BRANCH=main
