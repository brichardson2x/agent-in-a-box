PLATFORM=github
AGENT=codex
BOT_HANDLE=gitagent
REVIEWER_USERNAME=reviewer
WEBHOOK_SECRET=change-me
GITLAB_WEBHOOK_SECRET=change-me
GITHUB_APP_ID=123456
GITHUB_APP_PRIVATE_KEY_PATH=/path/to/github-app-private-key.pem
GITHUB_APP_INSTALLATION_ID=12345678
GITHUB_APP_CLIENT_ID=Iv1.abc123
GITLAB_APP_ID=your_gitlab_app_id
GITLAB_APP_SECRET=your_gitlab_app_secret
GITLAB_BOT_TOKEN=glpat-your-bot-token
REPO_PATH=/path/to/repo
REPO_REMOTE=git@github.com:owner/repo.git
AGENT_SYSTEM_PROMPT=You are GitAgent, a helpful automation assistant.

# Optional overrides
SQLITE_PATH=./data/agent.db
PORT=3000
LOG_LEVEL=info
DEFAULT_BRANCH=main
